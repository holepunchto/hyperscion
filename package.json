{
  "name": "hyperscion",
  "version": "0.0.0-rc.0",
  "description": "Peer-to-peer source control for agent-scale change volume, built on hyperbee2, autobee and blind peers.",
  "private": true,
  "bin": {
    "hs": "bin.mjs"
  },
  "upgrade": "pear://<YOUR_KEY_HERE>",
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare --timeout 300000 test/*.js",
    "test:e2e": "scripts/e2e.sh",
    "probes": "brittle-bare --timeout 300000 test/outage.js test/fixes.js test/review.js",
    "lint": "prettier . --check && lunte",
    "start": "bare bin.mjs --no-updates",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "autobee": "^2.12.1",
    "b4a": "^1.6.7",
    "bare-events": "^2.9.2",
    "bare-fs": "^4.0.0",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "bare-subprocess": "^6.2.2",
    "blind-peering": "^2.10.1",
    "compact-encoding": "^3.5.2",
    "compact-encoding-struct": "^1.3.0",
    "corestore": "^7.13.0",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hello-pear-worker": "^1.0.0",
    "hyperbee2": "^2.18.0",
    "hyperblobs": "^2.12.1",
    "hypercore": "^11.38.0",
    "hypercore-crypto": "^3.7.0",
    "hyperdht": "^6.34.1",
    "hyperdrive": "file:./vendor/hyperdrive",
    "hyperswarm": "^4.17.0",
    "localdrive": "^2.2.1",
    "mirror-drive": "^1.14.2",
    "node-diff3": "^3.2.1",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.2.0",
    "ready-resource": "^1.2.0",
    "sub-encoder": "^2.1.3",
    "unix-path-resolve": "^1.0.2",
    "which-runtime": "^1.4.0",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.2",
    "bare-runtime": "^1.34.1",
    "blind-peer": "^3.16.0",
    "brittle": "^3.19.0",
    "hyperschema": "^1.26.2",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "test-tmp": "^1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/hyperscion.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0"
}
