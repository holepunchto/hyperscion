{
  "name": "create-hyperscion",
  "productName": "hs",
  "version": "0.2.0",
  "description": "Peer-to-peer source control for agent-scale change volume, built on hyperbee2, autobee and blind peers.",
  "main": "install.js",
  "bin": {
    "create-hyperscion": "install.js"
  },
  "files": [
    "install.js",
    "README.md",
    "LICENSE"
  ],
  "upgrade": "pear://scioncigzgdpiwsr6een9suoj8irromdwor6ze9urfx9ya5sajry",
  "scripts": {
    "format": "prettier . --write",
    "test": "node scripts/test.js quick",
    "test:integration": "node scripts/test.js integration",
    "test:all": "node scripts/test.js all",
    "test:e2e": "scripts/e2e.sh",
    "probes": "brittle-bare --timeout 600000 test/flows.js test/metrics.js test/outage.js test/fixes.js test/review.js",
    "flows": "brittle-bare --timeout 600000 test/flows.js test/metrics.js test/coordination-props.js",
    "lint": "prettier . --check && lunte",
    "start": "bare bin.mjs --no-updates",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --standalone --name hs --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --standalone --name hs --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --standalone --name hs --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --standalone --name hs --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --standalone --name hs --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --standalone --name hs --host win32-x64 --out ./out/win32-x64 bin.mjs",
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "@holepunchto/replicator": "1.3.0",
    "autobee": "^2.13.6",
    "b4a": "^1.6.7",
    "bare-build": "^1.6.2",
    "bare-crypto": "^1.15.4",
    "bare-events": "^2.9.2",
    "bare-format": "^1.0.3",
    "bare-fs": "^4.0.0",
    "bare-os": "^3.9.4",
    "bare-path": "^3.1.3",
    "bare-process": "^4.5.0",
    "bare-runtime": "^1.37.1",
    "bare-storage": "^1.1.1",
    "bare-subprocess": "^6.2.2",
    "bare-tui": "^0.3.0",
    "bare-tui-paparam": "^0.2.0",
    "bare-worker": "^4.5.3",
    "blind-peer": "^3.18.2",
    "blind-peering": "^2.14.0",
    "brittle": "^4.5.0",
    "compact-encoding": "^3.7.0",
    "compact-encoding-struct": "^1.3.0",
    "corestore": "^7.16.1",
    "framed-stream": "^1.0.1",
    "gip-remote": "^2.2.0",
    "graceful-goodbye": "^1.3.3",
    "hello-pear-worker": "^1.0.0",
    "hyperbee2": "^2.22.0",
    "hyperblobs": "^2.13.0",
    "hypercore": "^11.40.4",
    "hypercore-crypto": "^3.7.0",
    "hyperdht": "^6.36.0",
    "hyperdrive": "file:./vendor/hyperdrive",
    "hyperschema": "^1.26.2",
    "hyperswarm": "^4.17.2",
    "ignore": "^7.0.14",
    "localdrive": "^2.2.1",
    "lunte": "^1.2.0",
    "mirror-drive": "^1.14.2",
    "node-diff3": "^4.0.0",
    "paparam": "^1.15.0",
    "pear-runtime": "^1.2.0",
    "prettier": "^3.10.1",
    "prettier-config-holepunch": "^2.0.0",
    "protomux": "^3.13.1",
    "ready-resource": "^1.2.0",
    "sub-encoder": "^2.1.3",
    "test-tmp": "^1.4.0",
    "unix-path-resolve": "^1.0.2",
    "which-runtime": "^1.4.0",
    "z32": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/hyperscion.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0"
}
